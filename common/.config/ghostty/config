#########
# Theme #
#########
#theme = dark:vesper,light:catppuccin-latte
#theme = dark:catppuccin-mocha,light:catppuccin-latte
theme = dark:nord,light:nord-light
# background = #1c2021
#background = #0B1215
#background-opacity = 0.90
#background-blur-radius = 20

##########
# Cursor #
##########
cursor-color = #e5e9f0
cursor-style = block
cursor-style-blink = true
#########
# Fonts #
#########
font-family = "Berkeley Nerd Font"
font-family-bold = "Berkeley Nerd Font" 
font-family-italic = "Berkeley Nerd Font"
font-family-bold-italic = "Berkeley Nerd Font"
font-size = 11
bold-is-bright = true
##########
# Mouse ##
##########
mouse-hide-while-typing = true
# mouse-scroll-multiplier = 1

##########
# Window #
##########
window-theme = system
window-decoration = auto
gtk-single-instance = true
gtk-tabs-location = bottom
gtk-wide-tabs = false
window-padding-y = 15,0
window-padding-balance = true

##########
# Others #
##########
copy-on-select = true

