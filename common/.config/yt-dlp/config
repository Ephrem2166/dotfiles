--ignore-errors
# --no-playlist

# Save in ~/Videos
-o ~/Videos/%(title)s.%(ext)s

# Prefer 1080p or lower
-f "bv*[height<=1080]+ba/b[height<=1080]/b"
# If you want to prefer mp4/m4a:
# -S "res:1080,ext:mp4:m4a"

--embed-metadata
--no-overwrites
--restrict-filenames
--sub-langs "en.*"
--embed-subs
--embed-thumbnail
--embed-chapters

# Change to "mkv/mp4" if you prefer MKV
--merge-output-format "mkv/mp4"

# --no-keep-fragments
--no-mtime

--replace-in-metadata "title" "\(Official Video\)|\(Audio\)|\(Official Video HD\)" ""
--replace-in-metadata "title" "\[Official Video\]|\[Audio\]|\[Official Video HD\]" ""
--replace-in-metadata "title" "\(Official Music Video\)|\(Audio\)" ""
--replace-in-metadata "title" "\[Official Music Video\]|\[Audio\]" ""
--replace-in-metadata "title" "\[Official HD Video\]|\[Audio\]" ""
--replace-in-metadata "title" "\(Official\)|\(official\)|\(HD\)|\[HD\]" ""

--parse-metadata "title:%(artist)s - %(title)s"
--parse-metadata "title:%(artist)s | %(title)s"

--concurrent-fragments 5
--progress
--trim-filenames 100


