--ignore-errors
# --no-playlist

# Save in ~/Videos
-o ~/Videos/%(title)s.%(ext)s

--buffer-size 4096

# Prefer 1080p or lower resolutions
-f bestvideo[ext=mp4][width<2000][height<=1200]+bestaudio[ext=m4a]/bestvideo[ext=webm][width<2000][height<=1200]+bestaudio[ext=webm]/bestvideo[width<2000][height<=1200]+bestaudio/best[width<2000][height<=1200]/best

# Embed metadata to the video file. Also adds chapters to file
--embed-metadata

# Do not overwrite existing output files
--no-overwrites

# Restrict filenames to only ASCII characters, and avoid "&" and spaces in filenames
--restrict-filenames

# Languages of the subtitle to download 
--sub-langs "en.*"

#  Embed subtitles in the video (only for mp4, webm and mkv videos)
--embed-subs

# Embed thumbnail in the video as cover art
--embed-thumbnail 

#  Add chapter markers to the video file
--embed-chapters

# Containers that may be used when merging formats 
--merge-output-format "mkv/mp4"

# Delete downloaded fragments after downloading is finished
--no-keep-fragments 

# Do not use .part files - write directly into output file
--no-part 