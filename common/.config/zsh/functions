# Yazi
# Use y and q to enter and exit yazi
function y() {
	local tmp="$(mktemp -t "yazi-cwd.XXXXXX")" cwd
	yazi "$@" --cwd-file="$tmp"
	IFS= read -r -d '' cwd < "$tmp"
	[ -n "$cwd" ] && [ "$cwd" != "$PWD" ] && builtin cd -- "$cwd"
	rm -f -- "$tmp"
}

# Open file with mupdf
function o() {
    if [ -z "$1" ]; then
        printf "Please specify file to read\n" > /dev/stderr
        false
    else
        mupdf -I "$1"
        true
    fi
}