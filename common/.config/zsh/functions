# Search for a process by name directly from terminal
# pf name
pf() {
  if [ -z "$1" ]; then
	printf "pf needs a process name to search for\n" >/dev/stderr
	false
  else
	ps -aux | rg "$1"
  fi
}

# Use update to update and upgrade system
# based on distro
update_system() {
  if command -v zypper &>/dev/null; then
	sudo zypper dup && flatpak update
  elif command -v pacman &>/dev/null; then
	sudo pacman -Syu && flatpak update
  fi
}

