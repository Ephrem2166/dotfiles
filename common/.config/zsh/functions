# Open files from a terminal
# open <file>
open_pdf() {
  xdg-open "$@" >/dev/null 2>&1 &
}

# Search for a process by name directly from terminal
# pf name
pf() {
  if [ -z "$1" ]; then
    printf "pf needs a process name to search for\n" >/dev/stderr
    false
  else
    ps -aux | rg "$1"
  fi
}

# Use update to update and upgrade system
# based on distro
update_system() {
  if command -v zypper &>/dev/null; then
    sudo zypper dup && flatpak update
  elif command -v pacman &>/dev/null; then
    sudo pacman -Syu && flatpak update
  fi
}

# Create and enter directory
mk() {
  mkdir -p "$@" && cd "$1" || echo "Unable to cd into $1"
}

# Create and open file
daily_file() {
  local today
  today="$(date -I)"
  file_name="${today}_$1".$2
  touch "$file_name" && nvim "$file_name"
}


# Get my ip
myip(){
  hostname -I | awk '{print $1}' && echo -n 'External: ' && curl -s ifconfig.me && echo
}

