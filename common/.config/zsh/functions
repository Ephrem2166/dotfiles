# Base 64 Encode and Decode
function b64e() {
  echo -n "$1" | base64 | wl-copy
  wl-paste
  echo >&2 'Copied to clipboard.'
}

function b64d() {
  echo -n "$1" | base64 --decode | wl-copy
  wl-paste
}

# Function to add a directory to PATH if it's not already included.
add_to_path() {
  local dir="$1"
  if [ -d "$dir" ] && [[ ":$PATH:" != *":$dir:"* ]]; then
	export PATH="$dir:$PATH"
  fi
}

# Command History Search with Grep and FZF
hgrep() {
  history | grep -i --color=auto "$@" | fzf
}

# Install useful tools (fzf and ripgrep)
install_tools() {
  echo "Installing fzf and ripgrep..."

  # Install fzf
  if ! command -v fzf >/dev/null 2>&1; then
	echo "Installing fzf..."
	sudo apt update && sudo apt install -y fzf
  else
	echo "fzf already installed"
  fi

  # Install ripgrep
  if ! command -v rg >/dev/null 2>&1; then
	echo "Installing ripgrep..."
	sudo apt update && sudo apt install -y ripgrep
  else
	echo "ripgrep already installed"
  fi

  echo "Tools installation complete!"
  echo "Reload your shell with: source ~/.zshrc"
}

# Delete files based on extension
cleanup() {
  local arg="$1"
  find . -type f -name "*.$1" -exec rm {} \;
}

# Top 10 Commands
top10() { history | awk '{a[$2]++ } END{for(i in a){print a[i] " " i}}' | sort -rn | head; }

# Go up specified number of directories
up() {
  local d=""
  limit=$1
  for ((i = 1; i <= limit; i++)); do
	d=$d/..
  done
  d=$(echo $d | sed 's/^\///')
  if [[ -z "$d" ]]; then
	d=..
  fi
  cd $d
}

# Show commands and the number of times they are used
freq_commands() {
  history | awk '{print $2};' | sort | uniq -c | sort -rn | head -10
}

# Make backup file
make-bak() {
		cp -a "$1" "${1}_$(date '+%Y-%m-%d').bak"
}
