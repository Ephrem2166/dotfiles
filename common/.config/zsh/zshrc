# External Programs
# Oh My Zsh
# Install Oh My Zsh!
if ! [[ -e ~/.oh-my-zsh ]]; then
  git clone git://github.com/robbyrussell/oh-my-zsh.git ~/.oh-my-zsh
fi
export ZSH="$HOME/.oh-my-zsh"
# Oh My Zsh
source $ZSH/oh-my-zsh.sh

# Install Zsh Syntax Highlighting
# if ! [[ -e ~/.oh-my-zsh-custom/plugins/zsh-syntax-highlighting ]]; then
#     mkdir ~/.oh-my-zsh-custom/plugins
#     git clone git://github.com/zsh-users/zsh-syntax-highlighting.git ~/.oh-my-zsh-custom/plugins/zsh-syntax-highlighting
# fi

HISTSIZE=1000000
# SAVEHIST=100000
HISTFILE="$HOME/.zsh_history"
HISTCONTROL=ignoreboth

# Enable Prompt Themes
autoload -U promptinit
promptinit
# Prompt Themes: use `prompt -l` to see themes
# To preview them: `prompt -p`
prompt fade

# Alias
[ -f "$XDG_CONFIG_HOME/zsh/alias" ] && source "$XDG_CONFIG_HOME/zsh/alias"

# Functions
[ -f "$XDG_CONFIG_HOME/zsh/functions" ] && source "$XDG_CONFIG_HOME/zsh/functions"

# Key Bindings
[ -f "$XDG_CONFIG_HOME/zsh/bindings.zsh" ] && source "$XDG_CONFIG_HOME/zsh/bindings.zsh"

# Completions
[ -f "$XDG_CONFIG_HOME/zsh/completion.zsh" ] && source "$XDG_CONFIG_HOME/zsh/completion.zsh"

# Options
[ -f "$XDG_CONFIG_HOME/zsh/options.zsh" ] && source "$XDG_CONFIG_HOME/zsh/options.zsh"

# Zprofile
[ -f "$XDG_CONFIG_HOME/zsh/zprofile" ] && source "$XDG_CONFIG_HOME/zsh/zprofile"

# LS COLORS
[ -f "$XDG_CONFIG_HOME/zsh/lscolors.sh" ] && source "$XDG_CONFIG_HOME/zsh/lscolors.sh"

# Export
[ -f "$XDG_CONFIG_HOME/zsh/exports" ] && source "$XDG_CONFIG_HOME/zsh/exports"

#export KEYTIMEOUT=1
#
# Theme
ZSH_THEME="robbyrussell"

