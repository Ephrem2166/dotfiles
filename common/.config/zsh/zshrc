# Export
# XDG BASE DIR CONFIGURATION
export XDG_CONFIG_HOME="$HOME/.config"
export XDG_DATA_HOME="$HOME/.local/share"
export XDG_CACHE_HOME="$HOME/.cache"
export XDG_STATE_HOME="$HOME/.local/state"

[ -d "$XDG_CONFIG_HOME" ] || mkdir -m 0750 "$XDG_CONFIG_HOME"
[ -d "$XDG_CACHE_HOME" ] || mkdir -m 0750 "$XDG_CACHE_HOME"
[ -d "$XDG_DATA_HOME" ] || mkdir -m 0750 "$XDG_DATA_HOME"
[ -d "$XDG_STATE_HOME" ] || mkdir -m 0750 "$XDG_STATE_HOME"

# Bootstrap .zshrc to ~/.config/zsh/.zshrc, any other zsh config files can also reside here
export ZDOTDIR="$XDG_CONFIG_HOME/zsh"

# Setting TERM
[[ -z "$TERM" ]] && export TERM="xterm-256color"

# Environment Variables
export TERMINAL=alacritty

# Scripts Folder
export PATH="$XDG_CONFIG_HOME/scripts:$PATH"

# Editor
export EDITOR=nvim
export VISUAL=nvim
export LANG=en_US.UTF-8
export SUDO_EDITOR=nvim

# External Programs
# Oh My Zsh
# Install Oh My Zsh!
if ! [[ -e ~/.oh-my-zsh ]]; then
  git clone git://github.com/robbyrussell/oh-my-zsh.git ~/.oh-my-zsh
fi
export ZSH="$HOME/.oh-my-zsh"

# Install Zsh Syntax Highlighting
# if ! [[ -e ~/.oh-my-zsh-custom/plugins/zsh-syntax-highlighting ]]; then
#     mkdir ~/.oh-my-zsh-custom/plugins
#     git clone git://github.com/zsh-users/zsh-syntax-highlighting.git ~/.oh-my-zsh-custom/plugins/zsh-syntax-highlighting
# fi

export PATH="/var/lib/flatpak/exports/bin:$PATH"

# Starship
export STARSHIP_CONFIG="$HOME/.config/starship/starship.toml"

# OTHER PROGRAM PATHS
export PATH="/usr/bin:$PATH"
export PATH="$HOME/.local/bin:$PATH"
# export PATH="$HOME/.npm-global/bin:$PATH"
export PATH="$HOME/.cargo/bin:$PATH"
export PATH="$HOME/.npm/bin:$PATH"
# export PATH="$HOME/.config/nvm/versions/node/v24.12.0/bin:$PATH"
# EMACS
export PATH=/usr/local/bin:/usr/bin:/bin:$HOME/.cargo/bin:$HOME/.local/bin:$HOME/.config/nvm/versions/node/v24.12.0/bin:
# Ripgrep
export RIPGREP_CONFIG_PATH="$HOME/.config/ripgrep/ripgreprc"

# Manpage
# export MANPAGER="less -R --use-color -Dd+r -Du+b"
# Use bat as man pager
# Alternatively use `batman`
export MANPAGER="sh -c 'awk '\''{ gsub(/\x1B\[[0-9;]*m/, \"\", \$0); gsub(/.\x08/, \"\", \$0); print }'\'' | bat -p -lman'"

