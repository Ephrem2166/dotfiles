# Setting VIMINIT Environment Variable
# Use `vimrc` from config directory
# export VIMINIT="$XDG_CONFIG_HOME/vim/vimrc"
#export VIMINIT='let $MYVIMRC="$XDG_CONFIG_HOME/vim/vimrc" | source $MYVIMRC'

HISTSIZE=1000000
# SAVEHIST=100000
HISTFILE="$HOME/.zsh_history"
HISTCONTROL=ignoreboth

autoload -U colors && colors
# Enable Prompt Themes
autoload -U promptinit
promptinit
# Prompt Themes: use `prompt -l` to see themes
# To preview them: `prompt -p`
prompt fade

# Alias
[ -f "$XDG_CONFIG_HOME/zsh/alias" ] && source "$XDG_CONFIG_HOME/zsh/alias"

# Functions
[ -f "$XDG_CONFIG_HOME/zsh/functions" ] && source "$XDG_CONFIG_HOME/zsh/functions"

# Key Bindings
[ -f "$XDG_CONFIG_HOME/zsh/keybinds" ] && source "$XDG_CONFIG_HOME/zsh/keybinds"

# Completions
[ -f "$XDG_CONFIG_HOME/zsh/completion.zsh" ] && source "$XDG_CONFIG_HOME/zsh/completion.zsh"

# Options
[ -f "$XDG_CONFIG_HOME/zsh/options.zsh" ] && source "$XDG_CONFIG_HOME/zsh/options.zsh"

#export KEYTIMEOUT=1
#
# Theme
ZSH_THEME="robbyrussell"

# Plugins
plugins=(
  git
  zsh-autosuggestions
  zsh-syntax-highlighting
  fast-syntax-highlighting
  zsh-history-substring-search
  zsh-fzf-history-search
  fzf-tab
)

# Oh My Zsh
source $ZSH/oh-my-zsh.sh

# Others Configuration

# Dircolors
export DIRCOLOR="$XDG_CONFIG_HOME/zsh/dircolors"
if [[ -x "$(command -v dircolors)" && -f "$DIRCOLOR" ]]; then
  eval "$(dircolors -b "$DIRCOLOR")"
fi

# FZF Shell integrations
eval "$(fzf --zsh)"

# FZF settings
# [ -f ~/.fzf.zsh ] && source ~/.fzf.zsh

# FZF Configuration
if [[ $(command -v "fzf") ]]; then
  source $XDG_CONFIG_HOME/zsh/fzf.zsh
fi

# PYENV
export PYENV_ROOT="$HOME/.pyenv"
[[ -d $PYENV_ROOT/bin ]] && export PATH="$PYENV_ROOT/bin:$PATH"
eval "$(pyenv init -)"

# STARSHIP
if hash starship 2>/dev/null; then
  eval "$(starship init zsh)"
fi

# Bare Dotfiles
#alias dotfiles='/usr/bin/git --git-dir=$HOME/.dotfiles --work-tree=$HOME'

export NVM_DIR="$([ -z "${XDG_CONFIG_HOME-}" ] && printf %s "${HOME}/.nvm" || printf %s "${XDG_CONFIG_HOME}/nvm")"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh" # This loads nvm
