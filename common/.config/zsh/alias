####################
# Shell Management #
####################
# Reload shell configuration
# alias reload='echo "Reloading .zshrc" && source ~/.zshrc'
alias reload='() {
local shell=${SHELL:-/usr/bin/zsh}
print -P "%F{cyan}↻ Reloading Zsh...%f"
  sleep 0.2
  exec -l "$shell"
}'

# Exit and Clear
alias c='clear'
alias q='exit'

# System
alias shutdown='sudo shutdown -h now'
alias restart='sudo reboot'
alias caffienate='systemd-inhibit tail -f /dev/null'
# Open Files from the terminal
alias open="open_command"

# Check battery
alias battery='cat /sys/class/power_supply/BAT0/capacity_level'

# sudo not required for some system commands
for command in mount umount su shutdown poweroff reboot zypper pacman dnf apt; do
  alias $command="sudo $command"
done
unset command

##################
# Grep and Tree  #
##################
# Productive defaults for grep and tree
alias grep='grep --color=auto --exclude-dir=.git'
alias tree='tree -F --dirsfirst -a -I ".git|.hg|.svn|__pycache__|.mypy_cache|.pytest_cache|*.egg-info|.sass-cache|.DS_Store"'
alias tree2='tree -L 2'
alias tree3='tree -L 3'

#####################
# Colorize Outputs  #
#####################
alias diff="diff --color=auto"
alias ip="ip -color=auto"

#######################
