###########
# # Zoxide #
###########
if hash zoxide 2>/dev/null; then
  eval "$(zoxide init zsh)"
  alias cd='zd'
  zd() {
    if [ $# -eq 0 ]; then
      builtin cd ~ && return
    elif [ -d "$1" ]; then
      builtin cd "$1"
    else
      z "$@" && printf "\U000F17A9 " && pwd || echo "Error: Directory not found"
    fi
  }

fi

