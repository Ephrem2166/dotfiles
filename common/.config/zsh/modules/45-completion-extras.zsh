# 45-completion-extras.zsh — runs AFTER compinit (40-completion.zsh).
# What cannot be a plain file on $fpath (35-tool-completions.zsh) lives here:
#   1. bash-style completions (terraform, aws, npm, pipx ...) via bashcompinit
#   2. tools whose script calls `compdef`/`compctl` itself (pnpm, pip) and gcloud
#   3. completion for YOUR OWN functions (t, mnt, umnt, fkill, up, serve, ...)
#   4. comp-status: shows what is generated / stubbed / failed
# Everything is guarded by "is the tool installed?"; init scripts are cached via _cache_path.

# ---------------------------------------------------------------------------
# 1. bash-style completions — bashcompinit is loaded only if one of these exists
# ---------------------------------------------------------------------------
_need_bash=0
for _c in terraform tofu vault consul nomad packer aws_completer npm pipx; do
  (( $+commands[$_c] )) && { _need_bash=1; break; }
done
(( _need_bash )) && { autoload -Uz bashcompinit && bashcompinit; }

if (( _need_bash )); then
  # HashiCorp tools complete themselves: `complete -C <binary> <name>`
  for _c in terraform tofu vault consul nomad packer; do
    (( $+commands[$_c] )) && complete -o nospace -C "$commands[$_c]" "$_c"
  done
  # AWS CLI v2
  (( $+commands[aws_completer] )) && complete -C "$commands[aws_completer]" aws
  # npm (the script is generated by node, so it is cached instead of run on every start)
  if _cache_path npm npm completion; then source "$REPLY"; fi
  # pipx (argcomplete)
  if (( $+commands[pipx] )) && _cache_path pipx register-python-argcomplete pipx; then
    source "$REPLY"
  fi
fi
unset _need_bash _c

# ---------------------------------------------------------------------------
# 2. Scripts that register themselves
# ---------------------------------------------------------------------------
if _cache_path pnpm pnpm completion zsh; then source "$REPLY"; fi
if _cache_path pip  pip completion --zsh; then source "$REPLY"; fi   # compctl-style, works under compinit

# Google Cloud SDK ships its own script (it loads bashcompinit itself)
for _c in /usr/share/google-cloud-sdk /opt/google-cloud-sdk "$HOME/google-cloud-sdk"; do
  [[ -r $_c/completion.zsh.inc ]] && { source "$_c/completion.zsh.inc"; break; }
done
unset _c

# ---------------------------------------------------------------------------
# 3. Completion for your own functions (70-functions.zsh / 76-fzf-functions.zsh)
#    (decompress, compress, make-bak, mk, fzfcd, cfile, cpath, zsh-plugins are in 70;
#     bif, bls and beet are in local/99-beet-override.zsh)
# ---------------------------------------------------------------------------
# t [session]: existing tmux sessions
_t() {
  local expl
  local -a sessions
  sessions=(${(f)"$(tmux list-sessions -F '#S' 2>/dev/null)"})
  _wanted sessions expl 'tmux session' compadd -a sessions
}
compdef _t t

# mnt <device> [mountpoint]
_mnt() {
  local expl
  local -a devs
  if (( CURRENT == 2 )); then
    devs=(${(f)"$(lsblk -pnro NAME 2>/dev/null)"})
    _wanted devices expl 'block device' compadd -a devs
  elif (( CURRENT == 3 )); then
    _directories
  fi
}
compdef _mnt mnt

# umnt [dir]: mounted directories under /mnt, /media, /run/media
_umnt() {
  local expl
  local -a mounts
  mounts=(${(f)"$(findmnt -rno TARGET 2>/dev/null)"})
  mounts=(${(M)mounts:#(/mnt|/media|/run/media)*})
  _wanted mounts expl 'mounted directory' compadd -a mounts
}
compdef _umnt umnt

_fkill()      { _arguments '1:signal:_signals' }
_up()         { _arguments '1:levels:(1 2 3 4 5 6 7 8 9)' }
_serve()      { _arguments '1:port:(8000 8080 8888 3000 5000 9000)' }
_genpass()    { _arguments '1:length:(16 20 24 32 48 64)' }
_gclone()     { _arguments '1:repository URL:_urls' '2:directory:_directories' }
_daily_file() { _arguments '1:name:' '2:extension:(md txt org tex rst)' }
_ch()         { _arguments '1:command or topic:_command_names' '2:subtopic:' }
compdef _fkill fkill
compdef _up up
compdef _serve serve
compdef _genpass genpass
compdef _gclone gclone
compdef _daily_file daily_file
compdef _ch ch
compdef _files trash y

# ---------------------------------------------------------------------------
# 4. comp-status — what did 35-tool-completions generate?
# ---------------------------------------------------------------------------
comp-status() {
  emulate -L zsh
  local f
  local -a all native stubs failed
  all=("$_comp_cache_dir"/_*(N.:t))
  for f in $all; do
    if command grep -q '^_gnu_generic' "$_comp_cache_dir/$f"; then
      stubs+=(${f#_})
    else
      native+=(${f#_})
    fi
  done
  failed=("$_comp_cache_dir"/.fail-*(N:t))
  print -P "%B%F{green}generated%f%b (${#native}):  ${(j: :)native}"
  print -P "%B%F{yellow}--help fallback%f%b (${#stubs}):  ${(j: :)stubs}"
  print -P "%B%F{red}failed%f%b (${#failed}) — tool is installed but gave no completion (old version?):  ${(j: :)${failed#.fail-}}"
  print "Rescan after installing into an unusual directory:  zsh-clean  (then open a new shell)"
}
