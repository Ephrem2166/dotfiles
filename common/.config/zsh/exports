# Export
# XDG BASE DIR CONFIGURATION
export XDG_CONFIG_HOME="$HOME/.config"
export XDG_DATA_HOME="$HOME/.local/share"
export XDG_CACHE_HOME="$HOME/.cache"
export XDG_STATE_HOME="$HOME/.local/state"

[ -d "$XDG_CONFIG_HOME" ] || mkdir -m 0750 "$XDG_CONFIG_HOME"
[ -d "$XDG_CACHE_HOME" ] || mkdir -m 0750 "$XDG_CACHE_HOME"
[ -d "$XDG_DATA_HOME" ] || mkdir -m 0750 "$XDG_DATA_HOME"
[ -d "$XDG_STATE_HOME" ] || mkdir -m 0750 "$XDG_STATE_HOME"

# Bootstrap .zshrc to ~/.config/zsh/.zshrc, any other zsh config files can also reside here
export ZDOTDIR="$XDG_CONFIG_HOME/zsh"

# Setting TERM
[[ -z "$TERM" ]] && export TERM="xterm-256color"

# Environment Variables
export TERMINAL=alacritty

# Scripts Folder
export PATH="$XDG_CONFIG_HOME/scripts:$PATH"

# Editor
EDITOR=vim
if hash nvim 2>/dev/null; then
  # export MANPAGER="nvim +'set cmdheight=1' +Man!"
  # export MANPAGER='nvim --cmd ":lua vim.g.noplugins=1" +Man!'
  # export MANPAGER="nvim +Man!"
  # export MANWIDTH=999
  EDITOR=nvim
fi
export EDITOR
export VISUAL="$EDITOR"

# export EDITOR=nvim
# export VISUAL=nvim
export LANG=en_US.UTF-8
export SUDO_EDITOR=nvim

# Manpage
# export MANPAGER="less -R --use-color -Dd+r -Du+b"
# Use bat as man pager
# Alternatively use `batman`
export MANPAGER="sh -c 'awk '\''{ gsub(/\x1B\[[0-9;]*m/, \"\", \$0); gsub(/.\x08/, \"\", \$0); print }'\'' | bat -p -lman'"

# export MANPAGER='less -s -M +Gg'

# Configure the time format for `ls` to display dates as "YYYY-MM-DD Day HH:MM".
export TIME_STYLE=+"%Y-%m-%d %a %H:%M"

# Flatpak
export PATH="/var/lib/flatpak/exports/bin:$PATH"

# OTHER PROGRAM PATHS
export PATH="/usr/bin:$PATH"
export PATH="$HOME/.local/bin:$PATH"
# export PATH="$HOME/.npm-global/bin:$PATH"
export PATH="$HOME/.cargo/bin:$PATH"
export PATH="$HOME/.npm/bin:$PATH"
# export PATH="$HOME/.config/nvm/versions/node/v24.12.0/bin:$PATH"
export PATH="$HOME/scripts/:$PATH"


# EMACS
export PATH=/usr/local/bin:/usr/bin:/bin:$HOME/.cargo/bin:$HOME/.local/bin:$HOME/.config/nvm/versions/node/v24.12.0/bin:
# Ripgrep
export RIPGREP_CONFIG_PATH="$HOME/.config/ripgrep/ripgreprc"

# less Colors
# export PAGER=less
# export LESS_TERMCAP_mb=$'\E[01;31m'             # begin blinking
# export LESS_TERMCAP_md=$'\E[01;31m'             # begin bold
# export LESS_TERMCAP_me=$'\E[0m'                 # end mode
# export LESS_TERMCAP_se=$'\E[0m'                 # end standout-mode
# export LESS_TERMCAP_so=$'\E[01;44;33m'          # begin standout-mode - info box
# export LESS_TERMCAP_ue=$'\E[0m'                 # end underline
# export LESS_TERMCAP_us=$'\E[01;32m'             # begin underline
# add color to man pages
export MANROFFOPT='-c'
export LESS_TERMCAP_mb=$(tput bold; tput setaf 2)
export LESS_TERMCAP_md=$(tput bold; tput setaf 6)
export LESS_TERMCAP_me=$(tput sgr0)
export LESS_TERMCAP_so=$(tput bold; tput setaf 3; tput setab 4)
export LESS_TERMCAP_se=$(tput rmso; tput sgr0)
export LESS_TERMCAP_us=$(tput smul; tput bold; tput setaf 8)
export LESS_TERMCAP_ue=$(tput rmul; tput sgr0)
export LESS_TERMCAP_mr=$(tput rev)
export LESS_TERMCAP_mh=$(tput dim)


# export MANPAGER="less -MR+Gg"

# PYENV
export PYENV_ROOT="$HOME/.pyenv"
[[ -d $PYENV_ROOT/bin ]] && export PATH="$PYENV_ROOT/bin:$PATH"
eval "$(pyenv init -)"

# Bare Dotfiles
#alias dotfiles='/usr/bin/git --git-dir=$HOME/.dotfiles --work-tree=$HOME'

export NVM_DIR="$([ -z "${XDG_CONFIG_HOME-}" ] && printf %s "${HOME}/.nvm" || printf %s "${XDG_CONFIG_HOME}/nvm")"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh" # This loads nvm

# Beet Completion
fpath=($XDG_CONFIG_HOME/beets/_beet $fpath)

# Setting VIMINIT Environment Variable
# Use `vimrc` from config directory
# export VIMINIT="$XDG_CONFIG_HOME/vim/vimrc"
#export VIMINIT='let $MYVIMRC="$XDG_CONFIG_HOME/vim/vimrc" | source $MYVIMRC'

# FZF Shell integrations
eval "$(fzf --zsh)"

# FZF settings
# [ -f ~/.fzf.zsh ] && source ~/.fzf.zsh

# FZF Configuration
if [[ $(command -v "fzf") ]]; then
  source $XDG_CONFIG_HOME/zsh/fzf.zsh
fi

# Dircolors
export DIRCOLOR="$XDG_CONFIG_HOME/zsh/dircolors"
if [[ -x "$(command -v dircolors)" && -f "$DIRCOLOR" ]]; then
  eval "$(dircolors -b "$DIRCOLOR")"
fi

