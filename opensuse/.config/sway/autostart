# Authentication
exec /usr/libexec/polkit-kde-authentication-agent-1

# Desktop Notification
# exec mako -c "$HOME/.config/mako/swayconfig" &
# exec dunst
exec swaync

# Audio
# Pipewire
# exec pipewire
# Pulseaudio
exec pulseaudio

# Cliphistory
exec wl-paste --type text --watch cliphist store
exec wl-paste --type image --watch cliphist store

# Waybar
exec waybar -c "$HOME/.config/waybar/swayconfig.jsonc" -l off &

# Autotiling
exec autotiling

# Network manager
exec_always nm-applet --indicator

# Gammastep
exec /usr/bin/gammastep
exec /usr/bin/gammastep-indicator

# wlnsunet
# exec wlsunset -l 9.005401 -L 38.763611 &
# exec wlsunset

# XDG Desktop Portal
# exec /usr/libexec/xdg-desktop-portal

# Gnome Settings
exec gsettings set org.gnome.desktop.interface color-scheme prefer-dark
exec gsettings set org.gnome.desktop.interface gtk-theme Adwaita
exec gsettings set org.gnome.desktop.interface font-name "Ubuntu Nerd Font"
exec gsettings set org.gnome.desktop.interface cursor-theme Adwaita
exec gsettings set org.gnome.desktop.interface cursor-size 30

# Emacs
# exec pkill -x emacs
# exec emacs --daemon &
exec /usr/bin/emacs --daemon
# Bluetooth
exec_always blueman-applet

exec_always /usr/lib/kdeconnectd
# exec_always /usr/bin/kdeconnect-indicator

# Enables inhibit_idle when playing audio
exec sway-audio-idle-inhibit

# Start idle service
# exec systemctl --user start swayidle.service

# Swayidle
# exec_always swayidle -w timeout 300 "$HOME/.config/swaylock/lock.sh" timeout 600 'swaymsg "output * power off"' resume 'swaymsg "output * power on"' before-sleep "$HOME/.config/swaylock/lock.sh"
# Swayidle with hyprlock
exec_always swayidle -w \
                timeout 300 'hyprlock' \
                timeout 600 'swaymsg "output eDP-1 dpms off"' \
                     resume 'swaymsg "output eDP-1 dpms on"' \
                before-sleep 'hyprlock'

