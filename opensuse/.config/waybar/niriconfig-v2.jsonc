// Niri Configuration
{
  "include": [
	"$HOME/.config/waybar/Modules.jsonc",
	"$HOME/.config/waybar/CustomModules.jsonc",
	"$HOME/.config/waybar/GroupModules.jsonc"
  ],
  /// GLOBAL CONFIG ///
  "layer": "bottom",
  "position": "top",
  "height": 22,
  "margin-left": 5,
  "margin-right": 5,
  "margin-top": 2,
  "margin-bottom": 2,
  "spacing": 0,
  "reload_style_on_change": true,
  "modules-left": [

	"clock#1"
	// "group/system"
	// "niri/window"
  ],
  "modules-center": [
	"niri/workspaces"
  ],
  "modules-right": [
      "custom/notification",
      "wireplumber",
      "group/system",
	"group/connection",
	"tray",
	"custom/power"
  ],
  "niri/workspaces": {
	"all-outputs": true,
	"format": "{icon}",
	"format-icons": {
	  // Named workspaces
	  // (you need to configure them in niri)
		"terminal" : " ",
		"file": " ",
		"browser": " ",
//		"chat": "<b></b>",
		"video": " ",
		// "music": " ",
//		"emacs": " ",
//	  "office": " ",
	  // Icons by state
	  // "active": "",
	  "default": " "
	},
		"on-scroll-up": "niri msg action focus-workspace-up",
		"on-scroll-down": "niri msg action focus-workspace-down",
  },
"niri/window": {
	"format": "{title}",
	"rewrite": {
		"(.*) - Mozilla Firefox": "🌎 $1",
		"(.*) - zsh": "> [$1]"
	}
}
}
