{
  "backlight#screen": {
	"device": "intel_backlight",
	"tooltip": true,
	"scroll-step": 1,
	"format": "{icon}  {percent}%",
	"format-icons": [
	  "󰹐",
	  "󱩎",
	  "󱩏",
	  "󱩐",
	  "󱩑",
	  "󱩒",
	  "󱩓",
	  "󱩕",
	  "󱩖"
	],
	"on-scroll-up": "brightnessctl -d intel_backlight set 1%+",
	"on-scroll-down": "brightnessctl -d intel_backlight set 1%-",
	// "on-click": "brightnessctl set +20 && brightnessctl get > /home/ephrem/.wob.sock ; pkill -x sh",
	"on-click": "brightnessctl -S 20 && brightnessctl -G",
	"on-click-right": "pkill -x wlsunset; wlsunset -O 4000K",
	"on-click-left": "wlsunset -t 4000K",
	"tooltip-format": "backlight {percent}%",
	"min-length": 6
	// "on-scroll-up": "brightnessctl set +10% && brightnessctl get  > /home/ephrem/.wob.sock ; pkill -x sh",
	// "on-scroll-down": "brightnessctl set 10%- && brightnessctl get  > /home/ephrem/.wob.sock ; pkill -x sh"
  },
  "backlight#keyboard": {
	"device": "tpacpi::kbd_backlight",
	// "exec": "brightnessctl -d tpacpi::kbd_backlight get | awk '{print int($1 * 50)}'",
	"format": " {icon} {percent}%",
	"format-icons": [
	  "",
	  "",
	  "",
	  "",
	  "",
	  "",
	  "",
	  "",
	  ""
	],
	"on-scroll-up": "brightnessctl -d tpacpi::kbd_backlight set 1%+",
	"on-scroll-down": "brightnessctl -d tpacpi::kbd_backlight set 1%-",
	"tooltip-format": "backlight {percent}%",
  },
  "backlight/slider": {
	"min": 0,
	"max": 20,
	"orientation": "horizontal",
	"device": "intel_backlight"
  },
  "battery": {
	//"interval": 5,
	"align": 0,
	"rotate": 0,
	"full-at": 100,
	"states": {
	  "warning": 30,
	  "critical": 15,
	  "good": 90
	},
	"format": "{icon} {capacity}%",
	"format-charging": " {capacity}%",
	"format-plugged": " {capacity}%",
	"format-alt": "{icon} {time}",
	"format-full": "{icon} {capacity}%",
	"format-icons": [
	  "󰂎",
	  "󰁺",
	  "󰁻",
	  "󰁼",
	  "󰁽",
	  "󰁾",
	  "󰁿",
	  "󰂀",
	  "󰂁",
	  "󰂂",
	  "󰁹"
	],
	"format-time": "{H}h {M}min",
	"tooltip": true,
	"tooltip-format": "{timeTo} {power}w"
  },
  "bluetooth": {
	"format": " {status}",
	"format-disabled": "󰂳",
	"format-on":  "  ",
	"format-connected": "󰂱 {num_connections}",
	"tooltip-format": " {device_alias}",
	"format-off": "󰂲",
	//"format-connected": " {device_alias}",
	"interval": 30,
	"on-click": "bluedevil",
	"format-no-controller": "",
	"tooltip-format-connected": "{device_enumerate}",
	"tooltip-format-enumerate-connected": " {device_alias} 󰂄{device_battery_percentage}%",
	"tooltip": true
  },
  "cava": {
	"cava_config": "$HOME/.config/cava/config",
	"framerate": 30,
	"autosens": 1,
	"sensitivity": 100,
	"bars": 14,
	"lower_cutoff_freq": 50,
	"higher_cutoff_freq": 10000,
	"method": "pulse",
	"source": "auto",
	"stereo": true,
	"reverse": false,
	"bar_delimiter": 0,
	"monstercat": false,
	"waves": false,
	"noise_reduction": 0.77,
	"input_delay": 2,
	"format-icons": [
	  "▁",
	  "▂",
	  "▃",
	  "▄",
	  "▅",
	  "▆",
	  "▇",
	  "█"
	],
	"actions": {
	  "on-click-right": "mode"
	}
  },
  "cpu": {
	"interval": 2,
	"format": "  {usage}%",
	"min-length": 5,
	"format-alt-click": "click",
	"format-alt": "{icon0}{icon1}{icon2}{icon3} {usage:>2}% 󰍛",
	"format-icons": [
	  "▁",
	  "▂",
	  "▃",
	  "▄",
	  "▅",
	  "▆",
	  "▇",
	  "█"
	],
	//    "format-alt": " {avg_frequency} GHz {max_frequency} GHz",
	"tooltip": true,
	"on-click": "alacritty -e htop"
  },
  "clock": {
	"tooltip": true,
	"interval": 1,
	"align": 1,
	//"format": "  {:%a %d %b %I:%M}",
	"format": "  {:%I:%M %p}", // AM PM format
	//"format": " {:%H:%M:%S}", // 24H
	"format-alt": " {:%I:%M   %Y, %d %B, %A}",
	"tooltip-format": "<tt><small>{calendar}</small></tt>",
	"calendar": {
	  "mode": "year",
	  "mode-mon-col": 3,
	  "weeks-pos": "right",
	  "on-scroll": 1,
	  "format": {
		"months": "<span color='#ffead3'><b>{}</b></span>",
		"days": "<span color='#ecc6d9'><b>{}</b></span>",
		"weeks": "<span color='#99ffdd'><b>W{}</b></span>",
		"weekdays": "<span color='#ffcc66'><b>{}</b></span>",
		"today": "<span color='#ff6699'><b><u>{}</u></b></span>"
	  }
	},
	"actions": {
	  "on-click-right": "mode",
	  //  "on-scroll-up": "tz_up",
	  //"on-scroll-down": "tz_down",
	  "on-scroll-up": "shift_up",
	  "on-scroll-down": "shift_down"
	}
  },
  "clock#1": {
	"format": "  {:%a %d %b %I:%M}",
	"tooltip": false,
	"interval": 1,
	"align": 1
  },
  "disk": {
	"interval": 30,
	//"format": "󰋊  {percentage_used}%",
	"format": "󰋊  {percentage_free}%",
	"path": "/home/",
	"on-click": "alacritty -e htop",
	"tooltip": true,
	"tooltip-format": "{used} used out of {total} on {path} ({percentage_used}%)",
	"unit": "GB"
  },
  "idle_inhibitor": {
	"format": "{icon}",
	"on-click-right": "hyprlock",
	"format-icons": {
	  "activated": " ",
	  "deactivated": " "
	},
	"tooltip": true,
	"tooltip-format-activated": "Idle_inhibitor active",
	"tooltip-format-deactivated": "Idle_inhibitor not active"
  },
  "idle_inhibitor#2": {
	"format": "{icon}",
	"on-click": "$HOME/.config/river/scripts/swayidle-toggle.sh; pkill -SIGRTMIN+1 waybar",
	"on-click-right": "hyprlock",
	"format-icons": {
	  "activated": " ",
	  "deactivated": " "
	},
	"tooltip": false
  },
  "image#album-art": {
	"path": "/tmp/mpd_cover.jpg",
	"size": 40,
	"interval": 1,
	"on-click": "swayimg /tmp/mpd_cover.jpg",
	"on-click-right": "alacritty -e ncmpcpp"
  },
  "keyboard-state": {
	"numlock": true,
	"capslock": true,
	//    "format": "{name} {icon}",
	"format": {
	  "numlock": "N {icon}",
	  "capslock": "󰪛 {icon}"
	},
	"format-icons": {
	  "locked": "",
	  "unlocked": ""
	}
  },
  "memory": {
	"interval": 10,
	//"format": "   {used:0.1f}G",
	"format": "   {}%",
	//"format": "{used:0.1f}G 󰾆",
	"format-alt": " {used:0.1f} GB  {swapUsed:0.1f} GB",
	"tooltip": true,
	"tooltip-format": "{used:0.1f}GB/{total:0.1f}G",
	//"on-click-right": "kitty --title btop sh -c 'btop'",
	"on-click": "alacritty -e htop"
  },
  "mpd": {
	"server": "127.0.0.1",
	"format": "{consumeIcon}{artist} - <span style=\"italic\">{title}</span>{singleIcon} {repeatIcon} {randomIcon} {stateIcon}",
	"format-disconnected": " ",
	"format-stopped": "{consumeIcon}{singleIcon}{repeatIcon}{randomIcon} ",
	"title-len": 42,
	"unknown-tag": "",
	"interval": 10,
	"on-click": "mpc --host=127.0.0.1 toggle > /dev/null",
	"on-click-right": "mpc --host=127.0.0.1 next > /dev/null",
	"on-click-middle": "mpc --host=127.0.0.1 prev > /dev/null",
	"consume-icons": {
	  "on": " "
	},
	"random-icons": {
	  "off": " ",
	  "on": " "
	},
	"repeat-icons": {
	  "on": " "
	},
	"single-icons": {
	  "on": "1 "
	},
	"state-icons": {
	  "playing": " ",
	  "paused": " "
	},
	"tooltip-format": "{artist} - {album}"
  },
  "mpris": {
	"interval": 10,
	"format": "{player_icon} ",
	// "format": "{status_icon} {artist} - {title}",
	"format-paused": "{status_icon} <i>{dynamic}</i>",
	"on-click-middle": "playerctl play-pause",
	"on-click": "playerctl previous",
	"on-click-right": "playerctl next",
	"scroll-step": 5.0,
	//"on-scroll-up": "$HOME/.config/hypr/scripts/Volume.sh --inc",
	//"on-scroll-down": "$HOME/.config/hypr/scripts/Volume.sh --dec",
	"smooth-scrolling-threshold": 1,
	"player-icons": {
	  "chromium": "",
	  "default": "",
	  "firefox": "",
	  "kdeconnect": "",
	  "mopidy": ":",
	  "mpv": " ",
	  "spotify": "",
	  "vlc": "󰕼"
	},
	"status-icons": {
	  "paused": "",
	  "playing": "",
	  "stopped": ""
	},
	// "ignored-players": ["firefox"]
	"max-length": 30
  },
  "network": {
	"interval": 10,
	"format": "{icon}",
	"format-wifi": "{icon}",
	// "format-wifi": "{icon}  {essid} {signalStrength}%",
	"format-ethernet": "{icon}",
	"format-alt": " {ipaddr} {netmask}",
	"format-disconnected": "",
	"format-alt-click": "click-right",
	"format-icons": {
	  "wifi": [
		"󰤯 ",
		"󰤟 ",
		"󰤢 ",
		"󰤥 ",
		"󰤨 ",
	  ],
	  "ethernet": [
		""
	  ],
	  "disconnected": [
		"󰤭 "
	  ]
	},
	"on-click": "alacritty -e nmtui",
	"tooltip": true,
	//   "tooltip-format-wifi": "{essid}||{signaldBm}dB||{frequency}MHz\n{ipaddr}/{cidr}\n{bandwidthUpBits}/{bandwidthDownBits}",
	//  "tooltip-format-ethernet": "{ipaddr}/{cidr}\n{bandwidthUpBits}/{bandwidthDownBits}",
	"tooltip-format": "{ipaddr}  {bandwidthUpBits}  {bandwidthDownBits}",
	"format-linked": "󰈁 {ifname} (No IP)",
	"tooltip-format-wifi": "{essid} {icon}  {signalStrength}%",
	"tooltip-format-ethernet": "{ifname} 󰌘",
	"tooltip-format-disconnected": "󰌙 Disconnected",
	"max-length": 30
  },
  "network#speed": {
	"interval": 1,
	"format": "{ifname}",
	"format-wifi": "{icon}  {bandwidthUpBytes}  {bandwidthDownBytes}",
	"format-ethernet": "󰌘  {bandwidthUpBytes}  {bandwidthDownBytes}",
	"format-disconnected": "󰌙",
	"tooltip-format": "{ipaddr}",
	"format-linked": "󰈁 {ifname} (No IP)",
	"tooltip-format-wifi": "{essid} {icon} {signalStrength}%",
	"tooltip-format-ethernet": "{ifname} 󰌘",
	"tooltip-format-disconnected": "󰌙 Disconnected",
	"min-length": 24,
	"max-length": 24,
	"format-icons": [
	  "󰤯",
	  "󰤟",
	  "󰤢",
	  "󰤥",
	  "󰤨"
	]
  },
  "power-profiles-daemon": {
	"format": "{icon}",
	"tooltip-format": "Power profile: {profile}\nDriver: {driver}",
	"tooltip": true,
	"format-icons": {
	  "default": "",
	  "performance": "",
	  "balanced": "",
	  "power-saver": ""
	}
  },
  "privacy": {
	"icon-spacing": 8,
	"icon-size": 24,
	"transition-duration": 350,
	"modules": [
	  {
		"type": "screenshare",
		"tooltip": true,
		"tooltip-icon-size": 28
	  },
	  {
		"type": "audio-out",
		"tooltip": true,
		"tooltip-icon-size": 28
	  },
	  {
		"type": "audio-in",
		"tooltip": true,
		"tooltip-icon-size": 28
	  }
	]
  },
  "pulseaudio": {
	"format": "{icon} {volume}%",
	"format-bluetooth": "{volume}%  {icon} {format_source}",
	"format-bluetooth-muted": " {icon} {format_source}",
	"format-muted": "󰖁",
	//"format-muted": " {format_source}",
	"format-source": "{volume}% ",
	"format-source-muted": "",
	"format-icons": {
	  "headphone": " ",
	  "hands-free": "󱡒 ",
	  "headset": "󰋎",
	  "phone": " ",
	  "portable": " ",
	  "car": " ",
	  "default": [
		" ",
		" ",
		" "
	  ]
	},
	"scroll-step": 5.0,
	"tooltip-format": "{icon} {desc} | {volume}%",
	"smooth-scrolling-threshold": 1,
	"on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle && pactl get-sink-volume @DEFAULT_SINK@ | head -n 1 | awk '{print substr($5, 1, length($5)-1)}' > /home/ephrem/.wob.sock",
	"on-scroll-up": "pactl set-sink-volume @DEFAULT_SINK@ +2% && pactl get-sink-volume @DEFAULT_SINK@ | head -n 1 | awk '{print substr($5, 1, length($5)-1)}' > /home/ephrem/.wob.sock",
	"on-scroll-down": "pactl set-sink-volume @DEFAULT_SINK@ -2% && pactl get-sink-volume @DEFAULT_SINK@ | head -n 1 | awk '{print substr($5, 1, length($5)-1)}' > /home/ephrem/.wob.sock",
	"on-click-right": "pavucontrol"
  },
  "temperature": {
	"interval": 5,
	"tooltip": true,
	"hwmon-path": [
	  // "/sys/class/hwmon/hwmon1/temp1_input",
	  // "/sys/class/hwmon/hwmon1/temp2_input",
	  // "/sys/class/hwmon/hwmon6/temp1_input",
	  "/sys/class/hwmon/hwmon7/temp1_input"
	  // "/sys/class/hwmon/hwmon7/temp2_input",
	  // "/sys/class/hwmon/hwmon7/temp3_input",
	  // "/sys/class/hwmon/hwmon7/temp4_input",
	  // "/sys/class/hwmon/hwmon7/temp5_input",
	  // "/sys/class/hwmon/hwmon7/temp6_input",
	  // "/sys/class/hwmon/hwmon7/temp7_input",
	  // "/sys/class/hwmon/hwmon7/temp8_input",
	  // "/sys/class/hwmon/hwmon8/temp1_input",
	  // "/sys/class/hwmon/hwmon8/temp2_input",
	  // "/sys/class/hwmon/hwmon8/temp3_input",
	  // "/sys/class/hwmon/hwmon8/temp4_input",
	  // "/sys/class/hwmon/hwmon8/temp5_input",
	  // "/sys/class/hwmon/hwmon8/temp6_input",
	  // "/sys/class/hwmon/hwmon8/temp7_input",
	  // "/sys/class/hwmon/hwmon8/temp8_input",
	  // "/sys/class/hwmon/hwmon8/temp9_input",
	  // "/sys/class/hwmon/hwmon8/temp10_input",
	  // "/sys/class/hwmon/hwmon8/temp34_input",
	  // "/sys/class/hwmon/hwmon8/temp35_input",
	  // "/sys/class/hwmon/hwmon8/temp14_input"
	],
	"critical-threshold": 90,
	"format-icons": [
	  ""
	],
	"format-critical": " {temperatureC}°C",
	"format": " {temperatureC}°C"
  },
  "tray": {
	"icon-size": 14,
	"spacing": 5,
	"show-passive-items": true,
	"reverse-direction": true
  },
  "wireplumber": {
	"format": "{icon}  {volume}%",
	"format-muted": "󰖁  {volume}%",
	"format-icons": [
	  "",
	  "",
	  ""
	],
	"on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle && pactl get-sink-volume @DEFAULT_SINK@ | head -n 1 | awk '{print substr($5, 1, length($5)-1)}' > /home/ephrem/.wob.sock",
	"on-scroll-up": "pactl set-sink-volume @DEFAULT_SINK@ +2% && pactl get-sink-volume @DEFAULT_SINK@ | head -n 1 | awk '{print substr($5, 1, length($5)-1)}' > /home/ephrem/.wob.sock",
	"on-scroll-down": "pactl set-sink-volume @DEFAULT_SINK@ -2% && pactl get-sink-volume @DEFAULT_SINK@ | head -n 1 | awk '{print substr($5, 1, length($5)-1)}' > /home/ephrem/.wob.sock",
	"on-click-right": "helvum"
  },
  "wlr/taskbar": {
	"format": "{icon}",
	"icon-size": 14,
	"icon-theme": "kora",
	"spacing": 0,
	"tooltip-format": "{title}",
	"on-click": "activate",
	"on-click-middle": "close",
	"ignore-list": [
	  "kitty",
	  "wezterm",
	  "foot",
	  "footclient"
	]
  }
}
