{
  "include": [
	"$HOME/.config/waybar/Modules.jsonc",
	"$HOME/.config/waybar/CustomModules.jsonc",
  ],
  "group/connection": {
	"orientation": "horizontal",
	"drawer": {
	  "click-to-reveal": false,
	},
	"modules": [
	  //"bluetooth",
	  "network",
	  "custom/wifi#2",
	  "custom/kdeconnect",
	  "bluetooth"
	  // "network#speed"
	  //"custom/wifi"
	],
  },
  "group/system": {
	"orientation": "horizontal",
	"drawer": {
	  // Reveal on mouse over or using click
	  "click-to-reveal": false,
	},
	"modules": [
	  "backlight#screen",
	  // "backlight/slider",
	  "battery",
	  // "upower",
	  "cpu",
	  "disk",
	  "memory",
	  "temperature"
	  // "power-profiles-daemon"
	  //"tray"
	]
  },
  "group/power": {
	"orientation": "horizontal",
	"drawer": {
	  "click-to-reveal": false,
	},
	"modules": ["custom/power", "custom/powerprofile"],
  },
  "group/custom-group": {
	"orientation": "horizontal",
	"modules": [
	  "idle_inhibitor",
	  "custom/kdeconnect",
	  "cava",
	  "custom/wifi"
	  // "custom/bluetooth"
	],
  },
  "group/tray-drawer": {
	"orientation": "horizontal",
	"drawer": {
	  "transition-duration": 300,
	},
	"modules": ["custom/tray-icon", "tray"],
  },
  "group/custom-network": {
	"orientation": "horizontal",
	"drawer": {
	  "click-to-reveal": false,
	},
	"modules": [
	  "custom/wifi#2",
	  "custom/bluetooth#2"
	],
  },
}
