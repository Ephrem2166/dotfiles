@import "~/.config/rofi/themes/nord.rasi"
configuration {
	show-icons: true;
	hover-select: true;
	kb-accept-entry: "Return,space";
	kb-cancel: "Escape";
}

* {
	background-color: @background;
	// text-color: @foreground;
}
/* ---- Window ---- */
window {
transparency: "real";
	height: 30%;
	width:                        15%;
	x-offset:                     0px;
	y-offset:                     0px;
	spacing:                      0px;
	padding:                      5px;
	margin:                       0px;
	border:                       0px;
	cursor:                       "default";
	location:                     center;
	anchor:                       center;
	fullscreen:                   false;
	enabled:                      true;
	border-radius:                12px;
	orientation: vertical;
	children: [ mainbox ];
}

/* ---- Mainbox ---- */
mainbox {
	// enabled:                      true;
	// orientation:                  horizontal;
	padding: 0px 0px;
	spacing:                      2px;
	// margin:                       0px;
	background-color:             @background;
	  children:                     ["inputbar", "listbox"];
}

inputbar {
	enabled:                      true;
	spacing:                      0px;
	padding:                      10px;
	border-radius:                0px;
	children:                     [ "textbox-prompt-colon", "entry" ];
}

textbox-prompt-colon {
	expand:                       false;
	padding:                      0px 0px;
	str:                          " ";
}

entry {
	// background-color:             transparent;
	padding: 0px 5px;
	border-radius: 12px;
	placeholder:                  "Search ...";
//	placeholder-color:            inherit;
}

/* ---- Listbox ---- */
listbox {
	spacing:                     0px;
	background-color:            transparent;
	orientation:                 vertical;
	children:                    [ "listview" ];
}



listview {
	lines: 1;
	spacing: 0px;
}
element {
padding: 5px;
border: 0;
border-radius: 12px;
background-color: @black;
color: @black;
}

element-icon {
	size: 200px;
}

element-text {
	enabled: false;
}

element selected.normal {
	background-color: @background;
	text-color:       @background;
}
