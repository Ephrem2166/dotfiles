// vim:ft=css
// To validate the config file rofi -rasi-validate ~/.config/rofi/config.rasi
configuration {
modi:                 "drun,run,filebrowser,window,calc";
dpi:                  80;
icon-theme:           "nordzy-dark";
show-icons:           true;
terminal:             "alacritty";
disable-history:      false;
max-history-size:     10;
display-drun:         " Apps"; // 󰀻
display-run:          " Runs";
display-nerdy:        "󰱨 Nerdy";
display-window:       " Windows";
display-filebrowser:  " Files";
display-ssh:          "󰣀 SSH";
display-keys:         " Keys";

filebrowser {
directory: "$HOME/";
}
}

@import "./themes/nord.rasi"


window {
  height: 50%;
  width: 20%;
  orientation: vertical;
  location: center;
  anchor: center;
  x-offset: 0px;
  y-offset: 0px;
  padding: 5px;
  margin: 0px;
  border: 1px;
  border-radius: 5px;
  spacing: 0;
  children: [ mainbox ];
}

mainbox {
  spacing: 0;
  children: [ inputbar, listview ];
}

inputbar {
  spacing: 0px;
  /*padding: top right bottom left*/
  padding: 10px;
  children: [ "textbox-prompt-colon", entry ];
}
/*prompt {
  padding: 3px;
  border-radius: 0px;
}*/
textbox-prompt-colon {
  expand: false;
  padding: 0px;
  str: " "; /* */
}

entry {
  placeholder:  "Search...";
  padding: 0px 5px;
  border-radius: 5px;
}

listview {
  lines: 12;
  spacing: 0px;
  scrollbar: false;
  /*padding: top right bottom left*/
  padding: 0px;
  border: 0px;
  border-radius: 5px;
  margin: 0px;
}

element {
  border: 0;
  padding: 3px;
  border-radius: 5px;
}
