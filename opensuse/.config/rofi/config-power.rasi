@import "~/.config/rofi/themes/nord.rasi"
/* ---- Configuration ---- */
/********************************************************************************************/
/* configuration {                                                                          */
/* 																						    */
/* 	display-window:             "WINDOW";												    */
/* 	hover-select:               true;													    */
/* 	me-select-entry:            "";														    */
/* 	me-accept-entry:            "MousePrimary";											    */
/* 	drun-display-format:        "{name}";												    */
/* 	window-format:              "{w} · {c} · {t}";										    */
/* 																						    */
/* }																					    */
