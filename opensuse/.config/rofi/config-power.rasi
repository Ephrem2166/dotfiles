@import "~/.config/rofi/themes/nord.rasi"
/* ---- Configuration ---- */
configuration {

	display-window:             "WINDOW";
	hover-select:               true;
	me-select-entry:            "";
	me-accept-entry:            "MousePrimary";
	drun-display-format:        "{name}";
	window-format:              "{w} · {c} · {t}";

}


/* ---- Window ---- */
window {
	height: 28%;
	width:                        15%;
	x-offset:                     0px;
	y-offset:                     0px;
	spacing:                      0px;
	padding:                      5px;
	margin:                       0px;
	border:                       1px;
	cursor:                       "default";
	transparency:                 "real";
	location:                     center;
	anchor:                       center;
	fullscreen:                   false;
	enabled:                      true;
	border-radius:                12px;
	orientation: vertical;
	children: [ mainbox ];
}

/* ---- Mainbox ---- */
mainbox {
	// enabled:                      true;
	// orientation:                  horizontal;
	padding: 0px 20px;
	spacing:                      0px;
	// margin:                       0px;
	// background-color:             @background;
	  children:                     ["inputbar", "listbox"];
}

inputbar {
	enabled:                      true;
	text-color:                   @foreground;
	spacing:                      0px;
	padding:                      10px;
	border-radius:                0px;
	border-color:                 @foreground;
	background-color:             @background;
	children:                     [ "textbox-prompt-colon", "entry" ];
}

textbox-prompt-colon {
	expand:                       false;
	padding:                      0px 0px;
	str:                          " ";
	background-color:             transparent;
	text-color:                   inherit;
}

entry {
	enabled:                      true;
	// background-color:             transparent;
	text-color:                   inherit;
	padding: 0px 5px;
	border-radius: 12px;
	cursor:                       text;
	placeholder:                  "Search ...";
	placeholder-color:            inherit;
}

/* ---- Listbox ---- */
listbox {
	spacing:                     20px;
	// background-color:            transparent;
	orientation:                 vertical;
	children:                    [ "listview" ];
}


/* ---- Listview ---- */
listview {
	enabled:                      true;
	columns:                      1;
	lines:                        12;
	cycle:                        true;
	dynamic:                      true;
	scrollbar:                    false;
	layout:                       vertical;
	reverse:                      false;
	fixed-height:                 true;
	fixed-columns:                true;
	spacing:                      0px;
	padding:                      0px;
	margin:                       0px;
	background-color:             @background;
	border:0px;
}

element {
	enabled:                      true;
	padding:                      10px;
	margin:                       5px;
	cursor:                       pointer;
	background-color:             @background;
	border-radius:                10px;
	border:                       @border-width;
}
